# Local Wi-Fi credentials for the board's ESP32-C6 (2.4 GHz only).
# Copy this file to wifi_credentials.defaults and fill in your own values.
# wifi_credentials.defaults is git-ignored and must never be committed.
CONFIG_ESP_WIFI_SSID="YOUR_SSID"
CONFIG_ESP_WIFI_PASSWORD="YOUR_PASSWORD"
CONFIG_ESP_WIFI_AUTH_WPA2_PSK=y
