# ESP-Hosted SDIO transport for ESP32-P4-WIFI6-POE-ETH (esp_hosted 2.13.x symbol names).
# Board wiring, verified from the schematic and a known-good 10_wifistation build:
#   onboard ESP32-C6 -> SDMMC Slot 1 : CMD=19 CLK=18 D0=14 D1=15 D2=16 D3=17, reset=GPIO54
#   TF card (SD1)    -> SDMMC Slot 0 : fixed P4 pins CLK=43 CMD=44 D0..D3=39-42
# Two different SDMMC slots, so Wi-Fi and the SD card can run at the same time.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_HOST_SDIO_SLOT=1
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
